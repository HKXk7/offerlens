# 复制这个文件为 .env，填入你的 key。
#
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会进版本库。

# ------------------------------------------------------------------
# 生成侧（跑评测必须填一个）
# ------------------------------------------------------------------
# 智谱 GLM —— 推荐。GLM-4.5-Flash / 4.7-Flash / 4-Flash 永久免费、不限 token。
# 申请：https://open.bigmodel.cn/  （手机号注册 → 右上角"API Key"）
ZHIPU_API_KEY=

# ------------------------------------------------------------------
# 硅基流动 —— 跨厂商对比的生成侧 + 裁判（推荐优先配这个）
# ------------------------------------------------------------------
# 一个 key 就能同时跑起生成侧和裁判侧，是目前信息量最大的配置：
#   · 生成侧矩阵：DeepSeek-V4-Flash / Qwen3.5-122B-A10B / Qwen3.5-27B / GLM-4.5-Air
#   · 裁判：腾讯 Hunyuan-A13B-Instruct（与上面四族都**不同族**，满足跨族要求）
# 价格见 src/agent/catalog.ts 的注释（中国站官网定价，2026-10）。
# 申请：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# ------------------------------------------------------------------
# 可选：对照用
# ------------------------------------------------------------------
# DeepSeek —— 便宜且强，用来回答"免费档到底够不够用"。
# 新用户送额度；官方定价约 ¥2/¥8 每百万 token（入/出）。
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------
# 本地兜底（不需要 key）
# ------------------------------------------------------------------
# 断网 / 额度用完时用。先装 Ollama 并拉模型：
#   ollama pull qwen2.5:7b
# 然后用 --profile 指向 ollama 的档位即可。
# 下载：https://ollama.com/download
