{
  "name": "offerlens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OfferLens · 求职 Agent 与它的评测回归平台（4 周版工程骨架）",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "db:init": "tsx scripts/init-db.ts",
    "cases:build": "tsx scripts/build-cases.ts",
    "demo": "tsx scripts/demo.ts",
    "diagnose": "tsx scripts/diagnose.ts",
    "jd:add": "tsx scripts/jd-add.ts",
    "jd:coverage": "tsx scripts/jd-coverage.ts",
    "eval:dry": "tsx scripts/run-eval.ts --dry-run",
    "eval": "tsx scripts/run-eval.ts",
    "eval:smoke": "tsx scripts/run-eval.ts --limit 4 --runs 1",
    "eval:report": "tsx scripts/run-eval.ts --report-only",
    "seed:demo": "tsx scripts/seed-demo-runs.ts",
    "serve": "tsx src/server/server.ts",
    "start": "tsx src/server/server.ts",
    "check:jds": "node scripts/check-jd-endpoint.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
